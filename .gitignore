# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# large raw video backups
*_ORIGINAL_*.mp4
*_RAW_*.mp4

# Formulaires PDF générés par les visiteurs : données personnelles, jamais dans le dépôt ni sur le site
formulaire_*.pdf

# Supabase CLI : fichiers locaux (projet lié, cache)
supabase/.temp/
supabase/.branches/

# Lockfile généré par deno test/check en local (Edge Functions déployées sans lock)
deno.lock
